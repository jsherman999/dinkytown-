{
  "name": "dinkytown-through-time",
  "version": "1.0.0",
  "description": "A browser-only, slightly-3D historical map of Dinkytown (Minneapolis) with a year slider from the 1880s to today. Planning stage. See [PLAN.md](PLAN.md).",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && tsc && vite build",
    "preview": "vite preview",
    "prepare-assets": "node scripts/build-fonts.mjs && node scripts/build-data.mjs",
    "data": "node scripts/build-data.mjs",
    "placeholder-data": "node scripts/make-placeholder-data.mjs && node scripts/build-data.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsherman999/dinkytown-.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jsherman999/dinkytown-/issues"
  },
  "homepage": "https://github.com/jsherman999/dinkytown-#readme",
  "type": "module",
  "private": "true",
  "dependencies": {
    "maplibre-gl": "^6.10.0"
  },
  "devDependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.2",
    "maplibre-font-maker-node": "^0.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
